<?xml version="1.0" encoding="utf-8" ?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SmartHome.Mobile.EditAutomationPage"
             Title="Επεξεργασία Αυτοματισμού"
             BackgroundColor="#F4F6FB">

    <ScrollView>

        <VerticalStackLayout Padding="25"
                             Spacing="18">

            <Label Text="Επεξεργασία Αυτοματισμού"
                   FontSize="28"
                   FontAttributes="Bold"
                   TextColor="#0F172A" />

            <!-- Όνομα -->

            <VerticalStackLayout Spacing="6">

                <Label Text="Όνομα"
                       FontAttributes="Bold"
                       TextColor="#0F172A" />

                <Entry x:Name="NameEntry"
                       BackgroundColor="White"
                       TextColor="#0F172A" />

            </VerticalStackLayout>

            <!-- Τύπος συνθήκης -->

            <VerticalStackLayout Spacing="6">

                <Label Text="Τύπος Συνθήκης"
                       FontAttributes="Bold"
                       TextColor="#0F172A" />

                <Picker x:Name="ConditionPicker"
                        Title="Επιλέξτε συνθήκη"
                        SelectedIndexChanged="OnConditionChanged">

                    <Picker.Items>
                        <x:String>Θερμοκρασία &gt;</x:String>
                        <x:String>Θερμοκρασία &lt;</x:String>
                        <x:String>Ενέργεια &gt;</x:String>
                        <x:String>Ώρα εκτέλεσης</x:String>
                    </Picker.Items>

                </Picker>

            </VerticalStackLayout>

            <!-- Source Device -->

            <VerticalStackLayout x:Name="SourceDeviceSection"
                                 Spacing="6">

                <Label Text="Συσκευή Πηγής"
                       FontAttributes="Bold"
                       TextColor="#0F172A" />

                <Picker x:Name="SourceDevicePicker"
                        Title="Επιλέξτε συσκευή"
                        ItemDisplayBinding="{Binding DisplayName}" />

            </VerticalStackLayout>

            <!-- Condition Value -->

            <VerticalStackLayout x:Name="ConditionValueSection"
                                 Spacing="6">

                <Label Text="Τιμή Συνθήκης"
                       FontAttributes="Bold"
                       TextColor="#0F172A" />

                <Entry x:Name="ConditionValueEntry"
                       Keyboard="Numeric"
                       BackgroundColor="White"
                       TextColor="#0F172A" />

            </VerticalStackLayout>

            <!-- Scheduled Time -->

            <VerticalStackLayout x:Name="ScheduledTimeSection"
                                 Spacing="6"
                                 IsVisible="False">

                <Label Text="Ώρα Εκτέλεσης"
                       FontAttributes="Bold"
                       TextColor="#0F172A" />

                <TimePicker x:Name="ScheduledTimePicker"
                            Format="HH:mm" />

            </VerticalStackLayout>

            <!-- Target -->

            <VerticalStackLayout Spacing="6">

                <Label Text="Συσκευή Στόχου"
                       FontAttributes="Bold"
                       TextColor="#0F172A" />

                <Picker x:Name="TargetDevicePicker"
                        Title="Επιλέξτε συσκευή"
                        ItemDisplayBinding="{Binding DisplayName}" />

            </VerticalStackLayout>

            <!-- Action -->

            <VerticalStackLayout Spacing="6">

                <Label Text="Ενέργεια"
                       FontAttributes="Bold"
                       TextColor="#0F172A" />

                <Picker x:Name="ActionPicker"
                        Title="Επιλέξτε ενέργεια">

                    <Picker.Items>
                        <x:String>Ενεργοποίηση</x:String>
                        <x:String>Απενεργοποίηση</x:String>
                        <x:String>Εναλλαγή κατάστασης</x:String>
                    </Picker.Items>

                </Picker>

            </VerticalStackLayout>

            <!-- Active -->

            <Grid ColumnDefinitions="*,Auto">

                <Label Text="Ενεργός Αυτοματισμός"
                       VerticalOptions="Center"
                       FontAttributes="Bold"
                       TextColor="#0F172A" />

                <Switch Grid.Column="1"
                        x:Name="ActiveSwitch" />

            </Grid>

            <Button Text="Αποθήκευση Αλλαγών"
                    Clicked="OnSaveClicked"
                    BackgroundColor="#2563EB"
                    TextColor="White"
                    FontAttributes="Bold"
                    CornerRadius="10"
                    HeightRequest="50" />

            <Label x:Name="MessageLabel"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center"
                   TextColor="Red" />

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>