<?xml version="1.0" encoding="UTF-8" ?>

<Shell
    x:Class="SmartHome.Mobile.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:SmartHome.Mobile"
    Title="SmartHome"
    Shell.FlyoutBehavior="Disabled">

    <!-- Σελίδα σύνδεσης -->
    <ShellContent
        Title="Σύνδεση"
        ContentTemplate="{DataTemplate local:MainPage}"
        Route="MainPage" />

    <!-- Κύριες καρτέλες εφαρμογής -->
    <TabBar Route="MainTabs">

        <ShellContent
            Title="Αρχική"
            Route="DashboardPage"
            ContentTemplate="{DataTemplate local:DashboardPage}" />

        <ShellContent
            Title="Συσκευές"
            Route="DevicesPage"
            ContentTemplate="{DataTemplate local:DevicesPage}" />

        <ShellContent
            Title="Αυτοματισμοί"
            Route="AutomationsPage"
            ContentTemplate="{DataTemplate local:AutomationsPage}" />

        <ShellContent
            Title="Ενέργεια"
            Route="EnergyPage"
            ContentTemplate="{DataTemplate local:EnergyPage}" />

    </TabBar>

</Shell>