<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SmartHome.Mobile.DashboardPage"
             BackgroundColor="#F4F6FB">

    <VerticalStackLayout Padding="30"
                         Spacing="20">

        <Label Text="Πίνακας Ελέγχου Έξυπνου Σπιτιού"
               FontSize="28"
               FontAttributes="Bold"
               TextColor="#0F172A" />

        <Border Padding="20"
                BackgroundColor="White"
                Stroke="#E2E8F0"
                StrokeThickness="1">

            <Border.StrokeShape>
                <RoundRectangle CornerRadius="18" />
            </Border.StrokeShape>

            <VerticalStackLayout Spacing="15">

                <Label Text="Στατιστικά Έξυπνου Σπιτιού"
                       FontSize="20"
                       FontAttributes="Bold"
                       TextColor="#0F172A" />

                <Label x:Name="TotalDevicesLabel"
                       Text="Σύνολο Συσκευών: 0" />

                <Label x:Name="OnlineDevicesLabel"
                       Text="Συνδεδεμένες Συσκευές: 0" />

                <Label x:Name="ActiveAutomationsLabel"
                       Text="Ενεργοί Αυτοματισμοί: 0" />

                <Label x:Name="PoweredOnLabel"
                       Text="Ενεργοποιημένες Συσκευές: 0" />

            </VerticalStackLayout>

        </Border>

    </VerticalStackLayout>

</ContentPage>