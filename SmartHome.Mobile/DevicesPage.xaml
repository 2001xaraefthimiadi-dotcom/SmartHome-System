<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SmartHome.Mobile.DevicesPage"
             BackgroundColor="#F4F6FB"
             Title="Devices">

    <Grid Padding="25"
          RowDefinitions="Auto,*,Auto"
          RowSpacing="15">

        <Grid Grid.Row="0"
      ColumnDefinitions="*,Auto">

            <Label Text="Devices"
           FontSize="28"
           FontAttributes="Bold"
           TextColor="#0F172A"
           VerticalOptions="Center" />

            <Button Grid.Column="1"
            Text="↻"
            FontSize="20"
            WidthRequest="45"
            HeightRequest="45"
            CornerRadius="22"
            Clicked="OnRefreshClicked" />

        </Grid>

        <RefreshView Grid.Row="1"
                     x:Name="DevicesRefreshView"
                     Refreshing="OnRefresh">

            <CollectionView x:Name="DevicesCollection">

                <CollectionView.ItemTemplate>
                    <DataTemplate>

                        <Border Padding="18"
        BackgroundColor="White"
        Stroke="#E2E8F0"
        StrokeThickness="1"
        Margin="0,0,0,12">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="16" />
                            </Border.StrokeShape>

                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
            Tapped="OnDeviceTapped"
            CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>

                            <VerticalStackLayout Spacing="6">

                                <Label Text="{Binding Name}"
               FontSize="20"
               FontAttributes="Bold"
               TextColor="#0F172A" />

                                <Label Text="{Binding Location}"
               TextColor="#64748B" />

                                <HorizontalStackLayout Spacing="10">

                                    <Label Text="{Binding StatusText}"
                   TextColor="#16A34A"
                   FontAttributes="Bold" />

                                    <Label Text="{Binding OnlineText}"
                   TextColor="#2563EB" />

                                </HorizontalStackLayout>

                                <Label Text="{Binding PowerText}"
               TextColor="#64748B" />

                            </VerticalStackLayout>

                        </Border>

                    </DataTemplate>
                </CollectionView.ItemTemplate>

            </CollectionView>

        </RefreshView>

        <Label Grid.Row="2"
               x:Name="MessageLabel"
               TextColor="Red"
               HorizontalOptions="Center" />

    </Grid>

</ContentPage>