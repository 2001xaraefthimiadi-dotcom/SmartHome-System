@page "/simulation"
@rendermode InteractiveServer
@inject SmartHome.Blazor.Services.ApiService Api

@using SmartHome.Blazor.Models

<div class="container mt-4">

    <h1 class="mb-4">Προσομοίωση Έξυπνου Σπιτιού</h1>

    <div class="row">

        <!-- ΑΡΙΣΤΕΡΟ ΠΑΝΕΛ -->
        <div class="col-md-4">

            <div class="card shadow p-4">

                <h4 class="mb-3">Εισαγωγή Μέτρησης Αισθητήρα</h4>

                <div class="mb-3">

                    <label class="form-label">Συσκευή</label>

                    <select class="form-select" @bind="reading.DeviceId">

                        <option value="0">Επιλέξτε συσκευή</option>

                        @if (devices != null)
                        {
                            @foreach (var device in devices)
                            {
                                <option value="@device.Id">
                                    @device.Name (@device.Location)
                                </option>
                            }
                        }

                    </select>

                </div>

                <div class="mb-3">

                    <label class="form-label">Τύπος Μέτρησης</label>

                    <select class="form-select" @bind="reading.ReadingType">
                        <option value="1">Θερμοκρασία</option>
                        <option value="2">Υγρασία</option>
                        <option value="3">Ενέργεια</option>
                    </select>

                </div>

                <div class="mb-3">

                    <label class="form-label">Τιμή</label>

                    <input class="form-control"
                           type="number"
                           step="0.1"
                           @bind="reading.Value" />

                </div>

                <button class="btn btn-primary w-100"
                        @onclick="SendReading">

                    Αποστολή Μέτρησης

                </button>

            </div>

        </div>

        <!-- ΔΕΞΙ ΠΑΝΕΛ -->
        <div class="col-md-8">

            <div class="card shadow p-4">

                <h4 class="mb-3">Αποτέλεσμα Προσομοίωσης</h4>

                @if (string.IsNullOrEmpty(responseMessage))
                {
                    <div class="alert alert-secondary">
                        Δεν έχει εκτελεστεί ακόμη κάποια προσομοίωση.
                    </div>
                }
                else
                {
                    <div class="alert alert-success">
                        Η προσομοίωση εκτελέστηκε επιτυχώς.
                    </div>

                    <pre class="bg-dark text-light p-3 rounded">
@responseMessage
                    </pre>
                }

            </div>

            <br />

            <div class="card shadow p-4">

                <h4 class="mb-3">Συνδεδεμένες Συσκευές</h4>

                @if (devices == null)
                {
                    <p>Φόρτωση συσκευών...</p>
                }
                else
                {
                    <table class="table table-striped">

                        <thead>

                            <tr>
                                <th>Όνομα</th>
                                <th>Τοποθεσία</th>
                                <th>Κατάσταση</th>
                                <th>Σύνδεση</th>
                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var device in devices)
                            {
                                <tr>

                                    <td>@device.Name</td>

                                    <td>@device.Location</td>

                                    <td>

                                        @if (device.Status == 1)
                                        {
                                            <span class="badge bg-success">
                                                ΕΝΕΡΓΗ
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                ΑΝΕΝΕΡΓΗ
                                            </span>
                                        }

                                    </td>

                                    <td>

                                        @if (device.IsOnline)
                                        {
                                            <span class="text-success">
                                                ● Συνδεδεμένη
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-danger">
                                                ● Εκτός σύνδεσης
                                            </span>
                                        }

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>
                }

            </div>

        </div>

    </div>

</div>

@code
{
    List<DeviceModel>? devices;

    ReadingModel reading = new()
    {
        ReadingType = 1
    };

    string? responseMessage;

    protected override async Task OnInitializedAsync()
    {
        devices = await Api.GetDevicesList();
    }

    async Task SendReading()
    {
        responseMessage = await Api.SendReading(reading);

        devices = await Api.GetDevicesList();

        await Task.Delay(3000);
    }
}