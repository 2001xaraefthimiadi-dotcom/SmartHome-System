@page "/automations"
@rendermode InteractiveServer
@inject SmartHome.Blazor.Services.ApiService Api

@using SmartHome.Blazor.Models

<div class="dashboard-title">
    Διαχείριση Αυτοματισμών
</div>

@if (!string.IsNullOrEmpty(message))
{
        <div class="alert alert-success shadow-sm">
            @message
        </div>
}

<div class="card shadow p-4 mb-4">

    <h4 class="mb-4">
        Δημιουργία Αυτοματισμού
    </h4>

    <div class="row">

        <div class="col-md-6">

            <div class="mb-3">
                <label class="form-label">Όνομα Αυτοματισμού</label>

                <input class="form-control"
                       @bind="newAutomation.Name"
                       placeholder="Όνομα Αυτοματισμού" />
            </div>

            @if (newAutomation.ConditionType != 4)
            {
                <div class="mb-3">
                    <label class="form-label">
                        Συσκευή Πηγής
                    </label>

                    <select class="form-select"
                            @bind="newAutomation.SourceDeviceId">

                        <option value="">
                            Επιλέξτε συσκευή πηγής
                        </option>

                        @if (devices != null)
                        {
                            @foreach (var device in devices)
                            {
                                <option value="@device.Id">
                                    @device.Name (@device.Location)
                                </option>
                            }
                        }

                    </select>
                </div>
            }

            <div class="mb-3">
                <label class="form-label">Τύπος Συνθήκης</label>

                <select class="form-select"
                        @bind="newAutomation.ConditionType">

                    <option value="1">
                        Θερμοκρασία μεγαλύτερη από
                    </option>

                    <option value="2">
                        Θερμοκρασία μικρότερη από
                    </option>

                    <option value="3">
                        Ενέργεια μεγαλύτερη από
                    </option>

                    <option value="4">
                        Ώρα εκτέλεσης
                    </option>

                </select>
            </div>

            @if (newAutomation.ConditionType == 4)
            {
                <div class="mb-3">
                    <label class="form-label">
                        Ώρα Εκτέλεσης
                    </label>

                    <input class="form-control"
                           type="time"
                           @bind="newAutomation.ScheduledTime" />
                </div>
            }
            else
            {
                <div class="mb-3">
                    <label class="form-label">
                        Τιμή Συνθήκης
                    </label>

                    <input class="form-control"
                           type="number"
                           step="0.1"
                           @bind="newAutomation.ConditionValue" />
                </div>
            }

        </div>

        <div class="col-md-6">

            <div class="mb-3">

                <label class="form-label">
                    Συσκευή Στόχου
                </label>

                <select class="form-select"
                        @bind="newAutomation.TargetDeviceId">

                    <option value="0">
                        Επιλέξτε συσκευή 
                    </option>

                    @if (devices != null)
                    {
                        @foreach (var device in devices)
                        {
                            <option value="@device.Id">
                                @device.Name (@device.Location)
                            </option>
                        }
                    }

                </select>

            </div>

            <div class="mb-3">

                <label class="form-label">
                    Ενέργεια
                </label>

                <select class="form-select"
                        @bind="newAutomation.Action">

                    <option value="1">
                        Ενεργοποίηση
                    </option>

                    <option value="2">
                        Απενεργοποίηση
                    </option>

                    <option value="3">
                        Εναλλαγή
                    </option>

                </select>

            </div>

        </div>

    </div>

    @if (isEditing)
    {
        <button class="btn btn-success"
                @onclick="SaveAutomation">
            Αποθήκευση Αλλαγών
        </button>

        <button class="btn btn-outline-secondary"
                @onclick="CancelEdit">
            Ακύρωση
        </button>
    }
    else
    {
        <button class="btn btn-primary"
                @onclick="CreateAutomation">
            Προσθήκη Αυτοματισμού
        </button>
    }

        <button class="btn btn-outline-secondary"
                @onclick="LoadData">

        Ανανέωση

        </button>

    </div>

<div class="card shadow p-4">

    <h4 class="mb-4">
        Ενεργοί Αυτοματισμοί
    </h4>

    @if (automations == null)
    {
        <p>Φόρτωση αυτοματισμών...</p>
    }
    else if (!automations.Any())
    {
        <p>Δεν βρέθηκαν αυτοματισμοί.</p>
    }
    else
    {
        <table class="table table-striped align-middle">

            <thead>

                <tr>
                    
                      <th>Όνομα</th>
                      <th>Συσκευή Πηγής</th>
                      <th>Συνθήκη</th>
                      <th>Συσκευή Στόχου</th>
                      <th>Ενέργεια</th>
                      <th>Κατάσταση</th>
                      <th>Ενέργειες</th>
                    
                </tr>

            </thead>

            <tbody>

                @foreach (var automation in automations)
                {
                    <tr>

                        <td>
                            @automation.Name
                        </td>

                        <td>
                            @(automation.SourceDeviceId.HasValue
                                ? GetDeviceName(automation.SourceDeviceId.Value)
                                : "-")
                        </td>

                        <td>
                            @if (automation.ConditionType == 4)
                            {
                                <span>
                                    @(automation.ScheduledTime?.ToString("HH:mm") ?? "-")
                                </span>
                            }
                            else
                            {
                                <span>
                                    @GetCondition(automation.ConditionType)
                                    @automation.ConditionValue
                                </span>
                            }
                        </td>

                        <td>
                            @GetDeviceName(automation.TargetDeviceId)
                        </td>

                        <td>
                            @GetAction(automation.Action)
                        </td>

                        <td>

                            @if (automation.IsActive)
                            {
                                <span class="status-on">
                                    🟢 ΕΝΕΡΓΟΣ
                                </span>
                            }
                            else
                            {
                                <span class="status-off">
                                    ⚫ ΑΝΕΝΕΡΓΟΣ
                                </span>
                            }

                        </td>
                        <td class="text-nowrap">

                            <button class="btn btn-sm btn-primary me-2"
                                    title="Επεξεργασία Αυτοματισμού"
                                    @onclick="() => StartEdit(automation)">
                                ✏️
                            </button>

                            <button class="btn btn-sm btn-danger"
                                    title="Διαγραφή Αυτοματισμού"
                                    @onclick="() => DeleteAutomation(automation.Id)">
                                🗑️
                            </button>

                        </td>

                    </tr>
                }

            </tbody>

        </table>
    }

</div>

@code {

    List<AutomationModel>? automations;

    List<DeviceModel>? devices;

    AutomationModel newAutomation = new()
    {
        ConditionType = 1,
        Action = 1
    };

    string? message;

    bool isEditing = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    async Task LoadData()
    {
        devices = await Api.GetDevicesList();
        automations = await Api.GetAutomations();
    }

    async Task CreateAutomation()
    {
        message = null;

        if (string.IsNullOrWhiteSpace(newAutomation.Name))
        {
            message = "Παρακαλώ εισάγετε όνομα αυτοματισμού.";
            return;
        }
        if (newAutomation.ConditionType != 4 &&
            !newAutomation.SourceDeviceId.HasValue)
        {
            message = "Παρακαλώ επιλέξτε συσκευή πηγής.";
            return;
        }

        if (newAutomation.ConditionType == 4 &&
            !newAutomation.ScheduledTime.HasValue)
        {
            message = "Παρακαλώ επιλέξτε ώρα εκτέλεσης.";
            return;
        }
        if (newAutomation.TargetDeviceId == 0)
        {
            message = "Παρακαλώ επιλέξτε συσκευή στόχου.";
            return;
        }

        var success =
            await Api.CreateAutomation(newAutomation);

        if (success)
        {
            message =
                "Ο αυτοματισμός δημιουργήθηκε επιτυχώς.";

            newAutomation = new AutomationModel
            {
                ConditionType = 1,
                Action = 1
            };

            await LoadData();
        }
        else
        {
            message =
                "Αποτυχία δημιουργίας αυτοματισμού.";
        }
    }

    string GetDeviceName(int deviceId)
    {
        var device = devices?
            .FirstOrDefault(d => d.Id == deviceId);

        return device == null
            ? $"Συσκευή  #{deviceId}"
            : device.Name;
    }

    string GetCondition(int conditionType) => conditionType switch
    {
        1 => "Θερμοκρασία > ",
        2 => "Θερμοκρασία < ",
        3 => "Ενέργεια > ",
        4 => "Ώρα εκτέλεσης ",
        _ => "Άγνωστη Συνθήκη "
    };

    string GetAction(int action) => action switch
    {
        1 => "Ενεργοποίηση",
        2 => "Απενεργοποίηση",
        3 => "Εναλλαγή",
        _ => "Άγνωστη Ενέργεια"
    };
    void StartEdit(AutomationModel automation)
    {
        isEditing = true;

        newAutomation = new AutomationModel
        {
            Id = automation.Id,
            Name = automation.Name,
            ConditionType = automation.ConditionType,
            ConditionValue = automation.ConditionValue,
            Action = automation.Action,
            TargetDeviceId = automation.TargetDeviceId,
            IsActive = automation.IsActive,
            SourceDeviceId = automation.SourceDeviceId,
            ScheduledTime = automation.ScheduledTime,
            LastExecutedAt = automation.LastExecutedAt
        };
    }

    async Task SaveAutomation()
    {
        message = null;

        if (string.IsNullOrWhiteSpace(newAutomation.Name))
        {
            message = "Παρακαλώ εισάγετε όνομα αυτοματισμού.";
            return;
        }

        if (newAutomation.ConditionType != 4 &&
            !newAutomation.SourceDeviceId.HasValue)
        {
            message = "Παρακαλώ επιλέξτε συσκευή πηγής.";
            return;
        }

        if (newAutomation.ConditionType == 4 &&
            !newAutomation.ScheduledTime.HasValue)
        {
            message = "Παρακαλώ επιλέξτε ώρα εκτέλεσης.";
            return;
        }

        if (newAutomation.TargetDeviceId == 0)
        {
            message = "Παρακαλώ επιλέξτε συσκευή στόχου.";
            return;
        }

        var success = await Api.UpdateAutomation(newAutomation);

        if (success)
        {
            message = "Ο αυτοματισμός ενημερώθηκε επιτυχώς.";

            isEditing = false;

            newAutomation = new AutomationModel();

            await LoadData();
        }
        else
        {
            message = "Αποτυχία ενημέρωσης αυτοματισμού.";
        }
    }

    async Task DeleteAutomation(int id)
    {
        var success = await Api.DeleteAutomation(id);

        if (success)
        {
            message = "Ο αυτοματισμός διαγράφηκε επιτυχώς.";

            await LoadData();
        }
        else
        {
            message = "Αποτυχία διαγραφής αυτοματισμού.";
        }
    }

    void CancelEdit()
    {
        isEditing = false;

        newAutomation = new AutomationModel();
	}
}