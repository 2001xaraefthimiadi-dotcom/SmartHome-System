@page "/devices"
@rendermode InteractiveServer
@inject SmartHome.Blazor.Services.ApiService Api

@using SmartHome.Blazor.Models

<div class="dashboard-title">
    Διαχείριση Συσκευών
</div>

@if (showNotification)
{
    <div class="alert alert-success shadow-sm">
        🔔 @notificationMessage
    </div>
}

@if (!string.IsNullOrEmpty(message))
{
    <div class="alert alert-success shadow-sm">
        @message
    </div>
}

<div class="card shadow p-4 mb-4">

    <h4 class="mb-4">
        Προσθήκη Νέας Συσκευής
    </h4>

    <label>Όνομα Συσκευής</label><br />
    <input class="form-control"
           @bind="newDevice.Name"
           placeholder="π.χ. Κεντρικό Φως Σαλονιού" />
    <br />

    <label>Τοποθεσία</label><br />
    <input class="form-control"
           @bind="newDevice.Location"
           placeholder="π.χ. Σαλόνι" />
    <br />

    <label>Τύπος Συσκευής</label><br />
    <select class="form-select" @bind="newDevice.Type">
        <option value="1">Φωτισμός</option>
        <option value="2">Θερμοστάτης</option>
        <option value="3">Αισθητήρας</option>
        <option value="4">Έξυπνη Πρίζα</option>
        <option value="5">Έξυπνη Κλειδαριά</option>
    </select>
    <br />

    <label>Κατανάλωση Ισχύος (W)</label><br />
    <input class="form-control"
           type="number"
           step="0.1"
           @bind="newDevice.PowerConsumption" />
    <br />

    @if (isEditing)
    {
        <button class="btn btn-success"
                @onclick="SaveDevice">
            Αποθήκευση Αλλαγών
        </button>

        <button class="btn btn-outline-secondary"
                @onclick="CancelEdit">
            Ακύρωση
        </button>
    }
    else
    {
        <button class="btn btn-primary"
                @onclick="CreateDevice">
            Προσθήκη Συσκευής
        </button>
    }

    <button class="btn btn-outline-secondary"
            @onclick="LoadDevices">
        Ανανέωση
    </button>

</div>

<hr />

@if (devices == null)
{
    <p>Φόρτωση συσκευών...</p>
}
else if (!devices.Any())
{
    <p>Δεν βρέθηκαν συσκευές.</p>
}
else
{
    <div class="card shadow p-4">

        <h4 class="mb-4">
            Συνδεδεμένες Συσκευές
        </h4>

        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th>Id</th>
                    <th>Όνομα</th>
                    <th>Τοποθεσία</th>
                    <th>Τύπος</th>
                    <th>Κατάσταση</th>
                    <th>Σύνδεση</th>
                    <th>Ισχύς</th>
                    <th>Ενέργειες</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var device in devices)
                {
                    <tr>
                        <td>@device.Id</td>
                        <td>@device.Name</td>
                        <td>@device.Location</td>
                        <td>@GetDeviceType(device.Type)</td>

                        <td>
                            @if (device.Status == 1)
                            {
                                <span class="status-on">🟢 ΕΝΕΡΓΗ</span>
                            }
                            else
                            {
                                <span class="status-off">⚫ ΑΝΕΝΕΡΓΗ</span>
                            }
                        </td>

                        <td>
                            @if (device.IsOnline)
                            {
                                <span class="text-success fw-bold">
                                    ● Συνδεδεμένη
                                </span>
                            }
                            else
                            {
                                <span class="text-danger fw-bold">
                                    ● Εκτός σύνδεσης
                                </span>
                            }
                        </td>

                        <td>@device.PowerConsumption W</td>

                        <td class="text-nowrap">
                            <button class="btn btn-sm btn-primary me-2"
                                    title="Επεξεργασία Συσκευής"
                                    @onclick="() => StartEdit(device)">
                                ✏️
                            </button>

                            <button class="btn btn-sm btn-danger"
                                    title="Διαγραφή Συσκευής"
                                    @onclick="() => DeleteDevice(device.Id)">
                                🗑️
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

    </div>
}

@code {
    List<DeviceModel>? devices;
    DeviceModel newDevice = new() { Type = 1 };
    string? message;
    bool isEditing = false;
    bool showNotification;
    string notificationMessage = "";

    protected override async Task OnInitializedAsync()
    {
        await LoadDevices();

        await Api.StartSignalRAsync(
            async () =>
            {
                await LoadDevices();
                await InvokeAsync(StateHasChanged);
            },
            async (message) =>
            {
                notificationMessage = message;
                showNotification = true;

                await InvokeAsync(StateHasChanged);

                await Task.Delay(3000);

                showNotification = false;
                await InvokeAsync(StateHasChanged);
            });
    }

    async Task LoadDevices()
    {
        devices = await Api.GetDevicesList();
    }

    async Task CreateDevice()
    {
        message = null;

        if (string.IsNullOrWhiteSpace(newDevice.Name))
        {
            message = "Παρακαλώ εισαγάγετε όνομα συσκευής.";
            return;
        }

        if (string.IsNullOrWhiteSpace(newDevice.Location))
        {
            message = "Παρακαλώ εισαγάγετε τοποθεσία.";
            return;
        }

        var success = await Api.CreateDevice(newDevice);

        if (success)
        {
            message = "Η συσκευή προστέθηκε επιτυχώς.";
            newDevice = new DeviceModel { Type = 1 };
            await LoadDevices();
        }
        else
        {
            message = "Αποτυχία προσθήκης συσκευής.";
        }
    }

    string GetDeviceType(int type) => type switch
    {
        1 => "Φωτισμός",
        2 => "Θερμοστάτης",
        3 => "Αισθητήρας",
        4 => "Έξυπνη Πρίζα",
        5 => "Έξυπνη Κλειδαριά",
        _ => "Άγνωστος Τύπος"
    };

    string GetStatus(int status) => status switch
    {
        0 => "Ανενεργή",
        1 => "Ενεργή",
        2 => "Αναμονή",
        _ => "Άγνωστη"
    };

    void StartEdit(DeviceModel device)
    {
        isEditing = true;

        newDevice = new DeviceModel
        {
            Id = device.Id,
            Name = device.Name,
            Location = device.Location,
            Type = device.Type,
            Status = device.Status,
            IsOnline = device.IsOnline,
            PowerConsumption = device.PowerConsumption
        };
    }

    async Task SaveDevice()
    {
        var success = await Api.UpdateDevice(newDevice);

        if (success)
        {
            message = "Η συσκευή ενημερώθηκε επιτυχώς.";
            isEditing = false;
            newDevice = new DeviceModel { Type = 1 };
            await LoadDevices();
        }
        else
        {
            message = "Αποτυχία ενημέρωσης συσκευής.";
        }
    }

    async Task DeleteDevice(int id)
    {
        var success = await Api.DeleteDevice(id);

        if (success)
        {
            message = "Η συσκευή διαγράφηκε επιτυχώς.";
            await LoadDevices();
        }
        else
        {
            message = "Αποτυχία διαγραφής συσκευής.";
        }
    }

    void CancelEdit()
    {
        isEditing = false;
        newDevice = new DeviceModel { Type = 1 };
    }
}