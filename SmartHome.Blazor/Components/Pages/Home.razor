@page "/"
@rendermode InteractiveServer
@inject SmartHome.Blazor.Services.ApiService Api

<div class="dashboard-title">
    Πίνακας Ελέγχου Έξυπνου Σπιτιού
</div>

<div class="row g-4 mb-4">

    <div class="col-md-3">
        <div class="card shadow p-4">
            <h6 class="text-muted">Σύνολο Συσκευών</h6>
            <h2>@totalDevices</h2>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card shadow p-4">
            <h6 class="text-muted">Συνδεδεμένες Συσκευές</h6>
            <h2 class="text-success">@onlineDevices</h2>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card shadow p-4">
            <h6 class="text-muted">Ενεργοί Αυτοματισμοί</h6>
            <h2 class="text-primary">@activeAutomations</h2>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card shadow p-4">
            <h6 class="text-muted">Ενεργοποιημένες Συσκευές</h6>
            <h2 class="text-warning">@poweredOnDevices</h2>
        </div>
    </div>

</div>

<div class="row g-4">

    <div class="col-md-4">
        <div class="card shadow p-4">
            <h4>🏠 Συσκευές</h4>
            <p class="text-muted">
                Διαχείριση και παρακολούθηση των έξυπνων συσκευών.
            </p>
            <NavLink href="/devices" class="btn btn-primary">
                Άνοιγμα Συσκευών
            </NavLink>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card shadow p-4">
            <h4>⚡ Ανάλυση Ενέργειας</h4>
            <p class="text-muted">
                Προβολή κατανάλωσης και ενεργειακών δεδομένων.
            </p>
            <NavLink href="/energy" class="btn btn-primary">
                Άνοιγμα Πίνακα Ενέργειας
            </NavLink>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card shadow p-4">
            <h4>🤖 Αυτοματισμοί</h4>
            <p class="text-muted">
                Διαμόρφωση και διαχείριση κανόνων αυτοματισμού.
            </p>
            <NavLink href="/automations" class="btn btn-primary">
                Άνοιγμα Αυτοματισμών
            </NavLink>
        </div>
    </div>

</div>

<div class="row g-4 mt-3">

    <div class="col-md-6">
        <div class="card shadow p-4">
            <h4>📡 Προσομοίωση</h4>
            <p class="text-muted">
                Προσομοίωση αισθητήρων και λειτουργιών του έξυπνου σπιτιού.
            </p>
            <NavLink href="/simulation" class="btn btn-dark">
                Άνοιγμα Προσομοίωσης
            </NavLink>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card shadow p-4">
            <h4>🔐 Αυθεντικοποίηση</h4>
            <p class="text-muted">
                Ασφαλής σύνδεση χρήστη με χρήση JWT.
            </p>
            <NavLink href="/login" class="btn btn-outline-primary">
                Σύνδεση
            </NavLink>
        </div>
    </div>

</div>

@code {
    int totalDevices;
    int onlineDevices;
    int poweredOnDevices;
    int activeAutomations;

    protected override async Task OnInitializedAsync()
    {
        await LoadDashboardStats();

        await Api.StartSignalRAsync(async () =>
        {
            await LoadDashboardStats();
            await InvokeAsync(StateHasChanged);
        });
    }

    async Task LoadDashboardStats()
    {
        try
        {
            var devices = await Api.GetDevicesList();
            var automations = await Api.GetAutomations();

            if (devices != null)
            {
                totalDevices = devices.Count;
                onlineDevices = devices.Count(d => d.IsOnline);
                poweredOnDevices = devices.Count(d => d.Status == 1);
            }

            if (automations != null)
            {
                activeAutomations = automations.Count(a => a.IsActive);
            }
        }
        catch
        {
            totalDevices = 0;
            onlineDevices = 0;
            poweredOnDevices = 0;
            activeAutomations = 0;
        }
    }
}